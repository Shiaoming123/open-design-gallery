{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "od-data-visualization-projects/entry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "project", "why", "dataShape", "encodings", "capture"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["lead", "accepted", "backfill-needed", "archived"] },
    "project": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } },
    "why": { "type": "string", "minLength": 1 },
    "dataShape": { "type": "string", "minLength": 1 },
    "hierarchy": { "type": "array", "items": { "type": "object" } },
    "encodings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "interactions": { "type": "array", "items": { "type": "object" } },
    "accessibility": { "type": "array", "items": { "type": "object" } },
    "capture": { "type": "object", "required": ["date", "sourceLinks", "attribution", "reusePolicy", "captureDepth"], "properties": { "date": { "type": "string", "format": "date" }, "sourceLinks": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }, "attribution": { "type": "string", "minLength": 1 }, "reusePolicy": { "type": "string", "minLength": 1 }, "captureDepth": { "type": "string", "minLength": 1 } } }
  }
}
